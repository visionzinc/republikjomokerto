  "posts": [
    {
      "id": "post-101",
      "authorId": "usr-superadmin-1",
      "contentText": "Dekrit Resmi Hari Ini: Seluruh warga baru yang mendaftar berhak mencetak Kartu Tanda Penjomok (KTP) masing-masing setelah melengkapi data profil. Lokasi default kita tetap NGAWI, namun domisili fiktif seperti Sumeru atau Mondstadt sah secara konstitusi hiburan.",
      "imageUrl": "/src/assets/images/hero_jomokerto_civic_1795010737788.jpg",
      "imageMimeType": "image/jpeg",
      "locationTag": "NGAWI",
      "likesCount": 42,
      "createdAt": "2026-11-17T09:00:00.000Z"
    },
    {
      "id": "post-102",
      "authorId": "usr-member-1",
      "contentText": "Laporan diplomasi dari Sumeru Akademiya: rute ekspedisi kopi susu gula aren dari Ngawi ke Port Ormos sudah dipetakan di Atlas Dunia Fiktif. Jangan lupa sematkan tautan sosmed kalian di profil KTP!",
      "imageUrl": "/src/assets/images/realm_atlas_bg_1795010739682.jpg",
      "imageMimeType": "image/jpeg",
      "locationTag": "Sumeru — Genshin Impact",
      "likesCount": 27,
      "createdAt": "2026-11-17T14:15:00.000Z"
    },
    {
      "id": "post-103",
      "authorId": "usr-admin-1",
      "contentText": "Pengingat ramah untuk warga dengan status Guest: akun kalian sudah bisa dipakai membaca timeline dan menyapa di ruang chat. Kalau mau dapat nomor seri KTP dan link-in-bio resmi, lengkapi biodata di menu KTP Studio ya.",
      "imageUrl": null,
      "imageMimeType": null,
      "locationTag": "NGAWI SELATAN",
      "likesCount": 19,
      "createdAt": "2026-11-18T02:10:00.000Z"
    }
  ],
